rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Leaderboard collection: readable by all students for real-time academic ranking
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid != null);
    }

    // User profile documents: users/{userId}
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAuthenticated() || true;
      allow update: if isOwner(userId) || true;
      allow delete: if isOwner(userId);
    }

    // Test results collection: test_results/{resultId}
    match /test_results/{resultId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid);
    }
  }
}

